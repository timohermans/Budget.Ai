# Django reads the same repository-level .env as the .NET app.
# ConnectionStrings__Budget uses the Npgsql key=value form.
ConnectionStrings__Budget=Host=localhost;Database=budget;Username=budget;Password=budget
# Or use a DATABASE_URL, which takes precedence when set:
# DATABASE_URL=postgres://budget:budget@localhost:5432/budget
# DATABASE_URL=sqlite:///budget.sqlite3

Oidc__Authority=
Oidc__ClientId=
Oidc__ClientSecret=

# Django
# BUDGET_SECRET_KEY=change-me
BUDGET_DEBUG=true
BUDGET_TEST_MODE=true
BUDGET_ALLOWED_HOSTS=localhost,127.0.0.1
# BUDGET_CSRF_TRUSTED_ORIGINS=https://budget.example.com