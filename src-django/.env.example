# Django reads the same repository-level .env as the .NET app.
# ConnectionStrings__Budget uses the Npgsql key=value form.
ConnectionStrings__Budget=Host=localhost;Database=budget;Username=budget;Password=budget
# Or use a DATABASE_URL, which takes precedence when set:
# DATABASE_URL=postgres://budget:budget@localhost:5432/budget
# DATABASE_URL=sqlite:///budget.sqlite3

Oidc__Authority=
Oidc__ClientId=
Oidc__ClientSecret=

# OpenTelemetry (shared with the .NET app)
# OpenTelemetry__Endpoint is the OTLP/HTTP logs endpoint; leave empty to disable.
OpenTelemetry__Endpoint=
# Collector auth header, e.g. Authorization=Basic <base64>
OpenTelemetry__Headers=
# Optional overrides; the standard OTEL_* variables are also honoured.
# OTEL_SERVICE_NAME=budget-django
# OTEL_ENVIRONMENT=production
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_TRACES_SAMPLER_ARG=1.0

# Django
# BUDGET_SECRET_KEY=change-me
BUDGET_DEBUG=true
BUDGET_TEST_MODE=true
BUDGET_ALLOWED_HOSTS=localhost,127.0.0.1
# BUDGET_CSRF_TRUSTED_ORIGINS=https://budget.example.com